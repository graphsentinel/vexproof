# Pinned versions for a reproducible lab. Sourced by scripts/platform.sh and scripts/lab.sh.
# Change a value here, not in the scripts. scripts/check-versions.sh lists newer upstream releases.
# Host tools: latest stable on 2026-10-13. Measurement tools (govulncheck, CodeQL, the measured Kubernetes and
# metrics-server releases) stay at the versions the results were measured with; newer ones are a separate run.
# Docker, python3, git, openssl, curl come from Ubuntu's packages.

# Host tools not packaged by Ubuntu, installed by scripts/platform.sh only when missing (sha256-checked)
GO_VERSION=1.27.2
GO_SHA256_AMD64=ecbadb99091a3f46e31f5f934b068b1864eafa7995211b39eaddf76996045fe5
GO_SHA256_ARM64=94f3e30b8e374bc285e7dadc11e0865726b9bc6e85b841ccceaabc0214c6b7c8
KUBECTL_VERSION=v1.37.1
K3D_VERSION=v5.9.0
# FULL=1 only
GOVULNCHECK_VERSION=v1.8.0
CODEQL_VERSION=2.25.2
CODEQL_SHA256=630af21d0bd1ceba2c67111039a7b9d1069553f43cbfc9cc942063e07364d79e

# k3d cluster: custom resources (TriggerTest, VexScan) and the FULL=1 runs
CLUSTER=vexproof
K3S_IMAGE=docker.io/rancher/k3s:v1.37.1-k3s1

# Official binaries the results were measured on (linux/amd64), downloaded by scripts/lab.sh install
K8S_DL=https://dl.k8s.io/release
BIN_v1_28_2_kube_apiserver=a6f95173a6de7e57057aca8c37e73c774f807e2b12660c563d351e089dd0a92c
BIN_v1_28_2_kubectl=c922440b043e5de1afa3c1382f8c663a25f055978cbc6e8423493ec157579ec5
BIN_v1_36_5_kube_apiserver=5132c822dd6f8b5713130a006117eb7b800738ac7d4e6d3f0cdd6d306bde14fb
BIN_v1_36_5_kubelet=2127c83a9a6ea4573e176ea42ba7415fadce0f05c998324b7154b4949dd2fdd0
BIN_v1_36_5_kubectl=33bc88a24c3b09cf55bfd59e6ca977881b61fc3f25ab65bc80c65b430248648e
# metrics-server v0.9.0: the binary inside the official image (no release binary is published)
METRICS_SERVER_IMAGE=registry.k8s.io/metrics-server/metrics-server:v0.9.0@sha256:d9862115e7c7881280d3d75ca26bda8ffc0fc213315979575bf23ce9826205c0
BIN_metrics_server_v0_9_0_metrics_server=a27ef2388c41ac560fcac1ff5f93df4114e156e1367b7702d462aab828f8a98d

# Images of the trigger check (lab/trigger/smoke-go-2026-6609.yaml): etcd sidecar and the image the binary runs in
ETCD_IMAGE=registry.k8s.io/etcd:3.5.9-0@sha256:e013d0d5e4e25d00c61a7ff839927a1f36479678f11e49502b53a5e0b14f10c3
BASE_IMAGE=docker.io/library/alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
